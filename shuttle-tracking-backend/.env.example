# Local backend development configuration. Copy this file to `shuttle-tracking-backend/.env`.
# The Compose stack instead reads the repository-root `.env`.

# Database
# Local development placeholder only. Update it when PostgreSQL uses another user, password, host,
# port, or database.
DATABASE_URL="postgres://shuttle_user:CHANGE_ME_IN_PRODUCTION@localhost:5432/shuttle_tracking"

# Redis
REDIS_URL="redis://localhost:6379"

# Server
NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001

# Authentication. CHANGE_ME_IN_PRODUCTION is accepted only by local development; replace both
# values before logging in, using senders, or testing TTN. Production rejects placeholders and weak
# values, and requires JWT_SECRET and TTN_WEBHOOK_SECRET to be different.
JWT_SECRET=CHANGE_ME_IN_PRODUCTION
JWT_EXPIRES_IN=8h
SENDER_JWT_EXPIRES_IN=15m

# CORS
FRONTEND_URL=http://localhost:3000

# TTN webhook authentication
TTN_WEBHOOK_SECRET=CHANGE_ME_IN_PRODUCTION

# Development-only seed credentials. The seed has no built-in admin password. Set all three values
# in your ignored local `.env` to create the admin/transport users and activate fixture sources.
# For Docker Compose, set these names in the repository-root `.env`; Compose does not load this
# backend example file.
SEED_ADMIN_PASSWORD=
TRACKING_SOURCE_SECRET_MOBILE=
TRACKING_SOURCE_SECRET_ESP32=

# Production first-admin provisioning is a separate, one-time operator action. Do not set
# SEED_ADMIN_PASSWORD in production. Use an ignored environment only for the explicit command:
# NODE_ENV=production PROVISION_INITIAL_ADMIN=true INITIAL_ADMIN_USERNAME=<operator-chosen> \
# INITIAL_ADMIN_PASSWORD=<strong-one-time-password> npx prisma db seed
# It succeeds only when the users table is empty, and should be unset immediately afterwards.
