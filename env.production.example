# Production Compose schema. Copy it only to an access-controlled file outside Git, then replace
# every REPLACE_WITH_ value. The production reverse proxy serves frontend, API, and Socket.IO on
# one public origin, so no NEXT_PUBLIC_* variable belongs here.

# Release identity (one immutable application version for both images)
APP_VERSION=REPLACE_WITH_RELEASE_VERSION

# PostgreSQL. DATABASE_URL must contain the same user, database, and password; percent-encode the
# password when it contains URL-reserved characters.
POSTGRES_USER=shuttle_user
POSTGRES_PASSWORD=REPLACE_WITH_POSTGRES_PASSWORD
POSTGRES_DB=shuttle_tracking
DATABASE_URL=postgresql://shuttle_user:REPLACE_WITH_URL_ENCODED_POSTGRES_PASSWORD@db:5432/shuttle_tracking

# Redis authentication: at least 16 URL-safe characters [A-Za-z0-9_-], no padding/whitespace.
# Redis remains transient; PostgreSQL is the durable record.
REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD

# Backend authentication and sender ingress
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JWT_EXPIRES_IN=8h
SENDER_JWT_EXPIRES_IN=15m
TTN_WEBHOOK_SECRET=REPLACE_WITH_A_DIFFERENT_32_CHARACTER_SECRET

# Browser/proxy contract. TRUST_PROXY is the exact final reverse-proxy address or narrow CIDR as
# observed by the backend; do not use a guessed Docker network, `true`, or a broad range.
FRONTEND_URL=https://tram-tracking.rsu.ac.th
TRUST_PROXY=REPLACE_WITH_EXACT_PROXY_IP_OR_CIDR
