# Local frontend configuration. Copy this file to `.env.local` (preferred) or `.env`.
# NEXT_PUBLIC_* values are compiled into the browser: never put a secret in them.

# Preferred API and Socket.IO backend origin for local development. It must be an origin only:
# no `/api` suffix, path, query string, fragment, or credentials.
NEXT_PUBLIC_BACKEND_ORIGIN=http://localhost:3001

# Legacy aliases NEXT_PUBLIC_BACKEND_URL and NEXT_PUBLIC_API_BASE_URL remain supported for existing
# deployments, but do not set them with NEXT_PUBLIC_BACKEND_ORIGIN unless all values resolve to the
# same origin. Production behind the documented one-origin reverse proxy needs no public override.
