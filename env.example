# Local Docker Compose configuration. Copy this file to the repository-root `.env`.
# This file is for development only; never reuse these placeholder values in production.

# PostgreSQL (used by the `db` service and the backend connection URL)
POSTGRES_USER=shuttle_user
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION
POSTGRES_DB=shuttle_tracking

# Backend authentication and TTN webhook authentication. Replace the placeholders before
# using logins, sender simulators, or webhook smoke tests.
JWT_SECRET=CHANGE_ME_IN_PRODUCTION
JWT_EXPIRES_IN=8h
SENDER_JWT_EXPIRES_IN=15m
TRIP_ACTIVITY_MIN_DISPLACEMENT_METERS=25
TRIP_ACTIVITY_MIN_SPEED_MPS=2
TTN_WEBHOOK_SECRET=CHANGE_ME_IN_PRODUCTION

# Development-only seed credentials. Set all three values to create the `admin` and `transport`
# accounts and activate the seeded mobile/ESP32 sources. Keep them only in the ignored `.env`.
SEED_ADMIN_PASSWORD=
TRACKING_SOURCE_SECRET_MOBILE=
TRACKING_SOURCE_SECRET_ESP32=
